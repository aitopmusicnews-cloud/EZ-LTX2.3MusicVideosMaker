# Copy this file to .env for local development. Never commit real credentials.

# Server
PORT=3001
PUBLIC_BASE_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
WEB_DIST_DIR=./apps/web/dist

# Storage: use local for development. Render can use S3 when every S3 variable is set.
STORAGE_BACKEND=local
STORAGE_DIR=./apps/api/storage
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_URL_BASE=

# Gemini multimodal planner used by the LTX Director Agent.
# The app does not use a rule-based Director fallback when this key is missing.
GEMINI_API_KEY=
GEMINI_DIRECTOR_MODEL=gemini-3.6-flash

# Native ComfyUI/LTXDirector section engine hosted on Modal.
# Created by: modal deploy modal/ltx_director_agent.py
# Paste the exact director_generate URL printed by Modal. Do not append /render-section.
LTX_DIRECTOR_URL=https://YOUR-WORKSPACE--mvs-ltx-director-director-generate.modal.run
# Not required for the Modal deployment. Leave blank unless using a non-Modal bearer-protected engine.
LTX_DIRECTOR_TOKEN=

# Legacy Modal LTX-2.3 endpoint for non-Director generation.
# Created by: modal deploy modal/ltx_video_agent.py
MODAL_LTX_URL=https://YOUR-WORKSPACE--mvs-ltx-video-generate.modal.run

# Optional Modal proxy-token protection. If MVS_MODAL_PROXY_AUTH=1 is used when
# deploying the Director, put the matching Modal proxy token pair here.
MODAL_KEY=
MODAL_SECRET=

# Other optional Modal services
MODAL_AUDIO_URL=
MODAL_MEDIA_SUITE_URL=
MODAL_LIPSYNC_URL=
MODAL_FILE_RESOLVER_URL=

# Optional local inference fallback
LOCAL_INFERENCE_URL=
